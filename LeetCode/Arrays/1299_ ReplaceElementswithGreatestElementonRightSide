class Solution {
    public int[] replaceElements(int[] arr) {
        int max=arr[arr.length-1];
        int replace=max;
        arr[arr.length-1]=-1;

        for(int i=arr.length-2; i>=0; i--){
            if(arr[i]>max){
                max=arr[i];
            }
            arr[i]=replace;
            replace=max;
        }
        
        return arr;
    }
}